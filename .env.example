# Copy to .env (same folder) and fill in. .env is gitignored; never commit it.
# With the defaults below the app runs end to end with fake providers and no accounts.

# --- LLM: anthropic | fake ---
# fake replays recorded responses from fixtures/llm/ (made for the fixture meeting), so the
# whole pipeline runs with no key. Set anthropic to call Claude for real.
LLM_PROVIDER=fake
# Required when LLM_PROVIDER=anthropic. Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Change via env, never hardcode
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium
# Server-side refusal fallback (beta). Set false if your model or account rejects it.
ANTHROPIC_REFUSAL_FALLBACK=true
MAX_LLM_TOKENS_PER_RUN=300000

# --- Code source: github | gitlab | fake ---
CODE_PROVIDER=fake
# GitHub fine-grained personal access token: Repository permissions > Contents: Read-only,
# "Only select repositories"
GITHUB_TOKEN=
GITLAB_BASE_URL=https://gitlab.com
# GitLab personal access token with scope read_api (add read_repository if tree calls fail)
GITLAB_TOKEN=

# --- Jira: jira | fake ---
JIRA_PROVIDER=fake
JIRA_BASE_URL=https://yourcompany.atlassian.net
JIRA_EMAIL=
# https://id.atlassian.com/manage-profile/security/api-tokens
# This token can do anything your Jira user can. Prefer a dedicated Jira user if possible.
JIRA_API_TOKEN=

# --- Limits ---
MAX_CODE_FILES=60
MAX_FILE_BYTES=200000
MAX_SCREENSHOTS=10
MAX_SCREENSHOT_BYTES=8000000
# Total bytes of code read per run, and the largest transcript accepted
MAX_TOTAL_CODE_BYTES=400000
MAX_TRANSCRIPT_BYTES=2000000
