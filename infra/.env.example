# Copy to infra/.env and fill in. Never commit infra/.env.
# Generate secrets with:  openssl rand -base64 32
# Note: no inline comments after values (docker compose env_file would include them in the value).

# --- shared ---
NODE_ENV=development
# api <-> agent shared secret, at least 16 characters
SERVICE_TOKEN=change-me-to-a-long-random-string

# --- api ---
DATABASE_URL=postgresql://mtj:mtj@postgres:5432/mtj
REDIS_URL=redis://redis:6379
# at least 32 characters
JWT_SECRET=change-me-to-a-long-random-string-xxxxxxxx
# base64 of exactly 32 random bytes: openssl rand -base64 32
TOKEN_ENC_KEY=
# id stored with every ciphertext; change it when you rotate TOKEN_ENC_KEY
TOKEN_ENC_KEY_ID=k1
# retired keys still accepted for decryption, format "k0:base64,k00:base64"
TOKEN_ENC_OLD_KEYS=
S3_ENDPOINT=http://s3:9000
S3_BUCKET=mtj-files
S3_ACCESS_KEY=mtjlocal
S3_SECRET_KEY=mtjlocalsecret
AGENT_BASE_URL=http://agent:8000
WEB_ORIGIN=http://localhost:5173
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT=common

# --- agent ---
ANTHROPIC_API_KEY=
# set from current Anthropic docs
ANTHROPIC_MODEL=
LANGGRAPH_DATABASE_URL=postgresql://mtj:mtj@postgres:5432/mtj_langgraph
API_BASE=http://api:3000
MAX_LLM_TOKENS_PER_RUN=300000
MAX_CODE_FILES=60
MAX_FILE_BYTES=200000

# --- host port overrides (optional) ---
POSTGRES_HOST_PORT=5433
